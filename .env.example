FAST_3D_MODEL=triposr
HIGH_QUALITY_3D_MODEL=trellis

TRELLIS_MODEL_ID=
HUNYUAN_MODEL_ID=
TRIPOSR_MODEL_ID=

# Python services
AI_SERVICE_URL=http://localhost:8001
MODEL_SERVICE_URL=http://localhost:8002

# Authentication
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d
