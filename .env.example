# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=file:./dev.db

# AI
GEMINI_API_KEY=
MISTRAL_API_KEY=

DEFAULT_AI_PROVIDER=gemini
VISION_PROVIDER=gemini
REASONING_PROVIDER=mistral

# 3D Models
